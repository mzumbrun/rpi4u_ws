<?xml version="1.0"?>

<robot name="mybots" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Load Simulated or Real Hardware Interfaces -->
   <xacro:arg name="is_sim" default="true"/>
   <xacro:arg name="use_ros2_control" default="true"/>

  <!-- Include physical aspects of the robot, includes add-ons -->
  <xacro:include filename="$(find mybots_description)/urdf/smallbot_physical.urdf.xacro" />
  <xacro:include filename="$(find mybots_description)/urdf/little_arm.urdf.xacro" />


  <!-- Include ros2 control Parameters for both SIM and REAL robots-->
  <xacro:include filename="$(find mybots_description)/urdf/smallbot_ros2_control.xacro" />

 
  <!-- Include gazebo Plugins for SIM only -->
  <xacro:if value="$(arg use_ros2_control)">
      <xacro:include filename="$(find mybots_description)/urdf/smallbot_gazebo_control.xacro" />
  </xacro:if>


</robot>
